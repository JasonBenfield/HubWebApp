{
  "compileOnSave": true,
  "compilerOptions": {
    "lib": [ "es2022", "dom" ],
    "module": "commonjs",
    "esModuleInterop": true,
    "noImplicitAny": false,
    "noEmitOnError": true,
    "removeComments": false,
    "sourceMap": true,
    "target": "es2022",
    "importHelpers": true,
    "typeRoots": [
      "../../node_modules/@types"
    ]
  },
  "include": [
    "./**/*.ts",
    "../Lib/**/*.d.ts",
    "../../node_modules/@jasonbenfield/**/*.d.ts",
    "../../node_modules/@types/jquery/**/*.d.ts"
  ],
  "exclude": [
    "Imports",
    "node_modules",
    "wwwroot"
  ]
}